{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Marketplace",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/packages/marketplace",
            "command": "yarn dev"
        },
        {
            "name": "Admin",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/packages/admin",
            "command": "yarn dev"
        }
    ],
    "compounds": [
        {
            "name": "Run applications",
            "configurations": [
                "Marketplace",
                "Admin"
            ],
            "stopAll": true
        }
    ]
}