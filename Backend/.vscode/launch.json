{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "SsoApplication",
            "request": "launch",
            "mainClass": "org.workswap.sso.SsoApplication",
            "projectName": "sso"
        },
        {
            "type": "java",
            "name": "StatisticApplication",
            "request": "launch",
            "mainClass": "org.workswap.statistic.StatisticApplication",
            "projectName": "statistic"
        },
        {
            "type": "java",
            "name": "ServerApplication",
            "request": "launch",
            "mainClass": "org.workswap.ServerApplication",
            "projectName": "server"
        },
        {
            "name": "Server",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/Server",
            "command": "java -jar target/server-1.0.jar"
        },
        {
            "name": "Statistic",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/Statistic",
            "command": "java -jar target/statistic-1.0.jar"
        },
        {
            "name": "Sso",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/Sso",
            "command": "java -jar target/sso-1.0.jar"
        }
    ],
    "compounds": [
        {
            "name": "Run applications",
            "configurations": [
                "Server",
                "Statistic",
                "Sso"
            ],
            "stopAll": true
        }
    ]
}